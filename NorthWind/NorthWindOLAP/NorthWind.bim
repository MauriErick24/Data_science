            "isHidden": true,
            "expression": "FactSales[Quantity]*FactSales[UnitPrice]",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\" ThousandSeparator=\"True\"><Currency LCID=\"2058\" DisplayName=\"$ Español (México)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"1\" /></Format>"
