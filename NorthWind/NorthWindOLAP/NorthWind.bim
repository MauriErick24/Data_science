        "partitions": [
          {
            "name": "FactSales",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [dbo].[FactSales].*   FROM [dbo].[FactSales] ",
              "dataSource": "SqlServer DESKTOP-3SFQGID NorthWindDW"
            }
          }
        ],
        "measures": [
          {
            "name": "TotalQuantity",
            "expression": "SUM(FactSales[Quantity])"
          },
          {
            "name": "TotalNetSales",
            "expression": "SUM(FactSales[NetSales])"
          },
          {
            "name": "NumberOfSales",
            "expression": "DISTINCTCOUNT(FactSales[OrderID])"
          },
          {
            "name": "MeanOrder",
            "expression": "DIVIDE(SUM(FactSales[SalesAmount]), DISTINCTCOUNT(FactSales[OrderID]))"
          },
          {
            "name": "MeanTimeOfShipping",
            "expression": "AVERAGEX( FactSales, DATEDIFF( FactSales[OrderDate], FactSales[ShippedDate], DAY ))"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [dbo].[FactSales].*   FROM [dbo].[FactSales] "
