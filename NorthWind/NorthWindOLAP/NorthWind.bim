            "isDataTypeInferred": true,
            "expression": "FactSales[GrossSales]-(FactSales[GrossSales]*FactSales[Discount])",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
